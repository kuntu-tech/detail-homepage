generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id           Int      @id @default(autoincrement())
  user_name    String   @db.VarChar(255)
  password     String?  @db.VarChar(255)
  role         String?
  employee_id  String?  @db.VarChar(36)
  staff_id     String?
  department   String?
  position     String?
  phone_number String?  @unique(map: "phone_number")
  email        String?
  data_status  String?  @db.Char(1)
  created_time DateTime @default(now()) @db.Timestamp(6)
  updated_time DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("user")
}